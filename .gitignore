# PHP & Composer
# ==============================================================================
vendor/
composer.phar

# Composer lock files are usually committed in root apps, but if ignored in packages:
# composer.lock

# PHPUnit & Testing
.phpunit.result.cache
.phpunit.cache/
.php-cs-fixer.cache
phpunit.xml
!phpunit.xml.dist

